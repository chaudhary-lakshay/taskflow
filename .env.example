# Copy to .env (gitignored) and fill in. Never commit real values.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me

# Backend (shell / IDE env; Gradle does not read .env automatically)
DB_URL=jdbc:postgresql://localhost:5432/taskflow
DB_USER=taskflow
DB_PASSWORD=change-me
# Used from T02 on. No default in code: generate with  openssl rand -base64 32
JWT_SECRET=
# Demo seed (profile "demo" only). Both demo users get this password; no default exists.
DEMO_PASSWORD=
JWT_ISSUER=taskflow
JWT_TTL_SECONDS=3600
