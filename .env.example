# Copy to .env (gitignored) and fill in. Never commit real values.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me

# Required by `docker compose up` (it stops with a clear message if empty) and by the backend.
# Base64, at least 32 bytes, no default in code: openssl rand -base64 32
JWT_SECRET=

# Browser port of the compose stack (http://localhost:8081 by default)
FRONTEND_PORT=8081

# Demo seed data. Leave both empty for none. To seed: SPRING_PROFILES_ACTIVE=demo and a DEMO_PASSWORD
# of your choice (8+ characters); both demo users use it. No default exists.
SPRING_PROFILES_ACTIVE=
DEMO_PASSWORD=

JWT_ISSUER=taskflow
JWT_TTL_SECONDS=3600

# Only for running the backend outside Docker (`./gradlew bootRun`; Gradle does not read .env):
DB_URL=jdbc:postgresql://localhost:5432/taskflow
DB_USER=taskflow
DB_PASSWORD=change-me
